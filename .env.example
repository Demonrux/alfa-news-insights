# Database (Docker Postgres on port 5433)
DATABASE_URL=postgresql+psycopg://postgres:135759@localhost:5432/alfa

# LLM
LLM_API_BASE=https://changellenge.up.railway.app/v1
LLM_API_KEY=
LLM_TIMEOUT=120

# Approximate RUB per 1M tokens; update if the provider changes prices.
LLM_PRICE_GEMMA_4_26B_A4B_INPUT_RUB_PER_1M=4.48
LLM_PRICE_GEMMA_4_26B_A4B_OUTPUT_RUB_PER_1M=23
LLM_PRICE_GLM_5_3_FLASH_INPUT_RUB_PER_1M=5.10
LLM_PRICE_GLM_5_3_FLASH_OUTPUT_RUB_PER_1M=17
LLM_PRICE_QWEN3_6_35B_A3B_INPUT_RUB_PER_1M=5.33
LLM_PRICE_QWEN3_6_35B_A3B_OUTPUT_RUB_PER_1M=74
LLM_PRICE_DEEPSEEK_V4_1_FLASH_INPUT_RUB_PER_1M=10
LLM_PRICE_DEEPSEEK_V4_1_FLASH_OUTPUT_RUB_PER_1M=21
LLM_PRICE_QWEN3_VL_30B_A3B_INSTRUCT_INPUT_RUB_PER_1M=14.30
LLM_PRICE_QWEN3_VL_30B_A3B_INSTRUCT_OUTPUT_RUB_PER_1M=57.10
LLM_PRICE_KIMI_K2_6_INPUT_RUB_PER_1M=51
LLM_PRICE_KIMI_K2_6_OUTPUT_RUB_PER_1M=270

# Optional multilingual semantic retrieval (install with: pip install -e ".[ml]")
ML_EMBEDDING_MODEL=BAAI/bge-m3
ML_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# ML_DEVICE=cpu
